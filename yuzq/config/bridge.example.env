# 雨中情 WeCom Bridge 配置样例
# - 本机裸进程 / docker local：复制为 wecom-bridge/.env
# - 腾讯云：复制为 wecom-bridge/docker/tencent/.env
# 企业级绑定：一家企微企业 ↔ 一个 AF 租户；勿按业务员逐人填 owner。
#
# Docker 提示：
# - 本机 compose 会把 AF_* 中的 127.0.0.1/localhost 改成 host.docker.internal
# - 腾讯云 PUBLIC_BASE_URL 必须是 https 公网域名；DRY_RUN_* 设为 false

HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://bridge.example.com
DATA_DIR=data

# —— 企业微信自建应用 ——
WECOM_CORP_ID=wwxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# WECOM_API_BASE=https://qyapi.weixin.qq.com

# —— Agent Forge 企业级绑定 ——
# 支持中文租户 ID（Bridge/控制台会 percent-encode 后再写入 HTTP 头）
AF_TENANT_ID=雨中情
AF_DEFAULT_ROLE=operator
EXCEPTIONS_PATH=../config/exceptions.example.json

# —— Bridge 机器账号（仅服务端持有）——
# Runtime 侧推荐：
# AGENTFORGE_IDENTITY_MAP={"wecom-bridge":{"tenant":"雨中情","role":"admin","delegate":true}}
AF_BASE_URL=http://127.0.0.1:4096
AF_CONSOLE_BASE_URL=http://127.0.0.1:5173
AF_USERNAME=wecom-bridge
AF_PASSWORD=
# 合同录入协作（须已 inject「雨中情-合同录入」）；有 ID 则优先生效
# AF_INTAKE_TEAM_ID=tm_xxxxxxxx
AF_INTAKE_TEAM_NAME=雨中情-合同录入
RUN_POLL_INTERVAL_SEC=5
RUN_POLL_MAX_SEC=28800

# —— 确认深链 / 管理 ——
TICKET_SECRET=please-change-me
TICKET_TTL_SEC=1800
# 空 = 禁用 POST /admin/import-members；生产勿对外暴露该口
BRIDGE_ADMIN_TOKEN=

# 消息路径是否自动建链（生产可 false，仅允许同步/导入成员）
IDENTITY_AUTO_PROVISION=true
MEDIA_MAX_BYTES=20971520

# —— 联调开关 ——
DRY_RUN_FORGE=true
DRY_RUN_WECOM_SEND=true
